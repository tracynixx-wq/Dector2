{
  "name": "dector",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "electron-updater": "6.6.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.2",
    "vite": "7.1.7",
    "electron": "39.2.0",
    "electron-builder": "26.0.12"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.dector.desktop",
    "productName": "Dector",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Dector-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tracynixx-wq",
        "repo": "Dector2"
      }
    ]
  }
}